export KAFKA_BROKERS=localhost:9092
export K8S_APPLY_PORT=8080
# BRANCH is the nuke repo's own branch variable: it names the branch the init
# container clones and the image tag the Deployment pulls. STAGE below is the
# service's own value and does not substitute for it.
export BRANCH=dev
# STAGE drives the rendered Deployment's STAGE env. It is what the service reads
# to derive its make branch and its cqrs topic prefix.
export STAGE=dev
# Set on a stage that requires an approval (prod). Empty on dev, where the
# service wires the noop approver.
export ATTENTION_URL=
# Set on the dev stage: a dev apply that passes its post-apply health check
# promotes the component to sun through this gateway. Must be https unless the
# host is an in-cluster Service. Empty on sun and prod, which never promote.
export SUN_GATEWAY_URL=
# The initiator the sun gateway attributes the promotion to. Never written to a
# record or a log line.
export SUN_GATEWAY_INITIATOR=
# The credential the sun gateway authenticates the promotion with, sent as HTTP
# Basic. The initiator header alone is not an authentication mechanism: an
# unauthenticated command is answered 307 to Google OAuth. Never written to a
# record, a log line or an error.
export SUN_GATEWAY_USER=
export SUN_GATEWAY_PASSWORD=
export REPO_DIR=/repo
export DOCKER_REGISTRY=docker.io
export IMAGE=bborbe/k8s-apply
export CLUSTER_CONTEXT=test
