export KAFKA_BROKERS=localhost:9092
export K8S_APPLY_PORT=8080
# BRANCH is the nuke repo's own branch variable: it names the branch the init
# container clones and the image tag the Deployment pulls. STAGE below is the
# service's own value and does not substitute for it.
export BRANCH=dev
# STAGE drives the rendered Deployment's STAGE env. It is what the service reads
# to derive its make branch and its cqrs topic prefix.
export STAGE=dev
# Set on a stage that requires an approval (prod). Empty on dev, where the
# service wires the noop approver.
export ATTENTION_URL=
export REPO_DIR=/repo
export DOCKER_REGISTRY=docker.io
export IMAGE=bborbe/k8s-apply
export CLUSTER_CONTEXT=test
